rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Default-deny wildcard: no blanket reads. Specific paths below grant reads.
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Service-provider profile images: public read (rendered in customer app
    // and WA flow), admin-only writes (anti-fraud — May 2026).
    match /service_providers/{file=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && (request.auth.token.admin == true
                       || request.auth.token.role == 'admin')
                   && request.resource.size < 15 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // User-owned files: only the owner reads/writes their own folder.
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 15 * 1024 * 1024;
    }

    // Legacy "users/<id>.jpg" profile-image path used by older app versions
    // (StorageServices.uploadImageToFirebase(path:'users')). Authenticated
    // users only; image content; size capped.
    match /users/{file} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Artisan before/after work photos — uploaded by the assigned artisan
    // from the SP panel. Public read so the client app + WA bot can render
    // the proof images. Authenticated write only.
    match /artisan_work_images/{file=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 15 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Customer-side job/task attachments uploaded during booking creation.
    match /task_attachments/{file=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 15 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    match /job_images/{file=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 15 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Payment proof / deposit slips uploaded by users.
    match /users_payment_requests/{file=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Flag-issue / balance-proof uploads from the SP panel.
    match /balance_proofs/{file=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 15 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // AI-agent / task chat image attachments — authenticated users only.
    match /task_images/{file=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 15 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Booking attachments (photos, etc.) — authenticated users only.
    match /uploads/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Admin custom-claim path (legacy)
    match /admin/{allPaths=**} {
      allow read, write: if request.auth != null
                         && (request.auth.token.admin == true
                             || request.auth.token.role == 'admin');
    }
  }
}
