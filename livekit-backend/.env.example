# LiveKit (server-side secrets; NEVER commit your real .env)
LIVEKIT_WS_URL=wss://square-15-maintenance-app-n6ijx3po.livekit.cloud
LIVEKIT_API_KEY=YOUR_KEY
LIVEKIT_API_SECRET=YOUR_SECRET
LIVEKIT_AGENT_NAME=square15-voice-assistant

# Admin bootstrap key (used to set admin custom claims via /api/admin/bootstrap-claims)
ADMIN_BOOTSTRAP_KEY=YOUR_BOOTSTRAP_KEY

# Google Places + Geocoding (server-side proxy key). Must be an UNRESTRICTED
# server key (or restricted only by API to Places API New + Geocoding API).
# Used by /api/places/* and /api/geocode/* endpoints because Android-restricted
# keys cannot be used from raw HTTPS REST calls (no Play Services attestation).
GOOGLE_API_TOKEN=YOUR_SERVER_KEY

# CORS (optional)
# ALLOWED_ORIGINS=https://yourapp.example.com
